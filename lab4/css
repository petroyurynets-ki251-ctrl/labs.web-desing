* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f4f4;
    color: #222;
    line-height: 1.6;
}


header {
    height: 350px;
    background-color: #4d8bf5;
    text-align: center;
    padding-top: 60px;
}

header h1 {
    color: white;
    font-size: 42px;
    margin-bottom: 50px;
}


.navigation {
    list-style: none;
}

.navigation li {
    display: inline-block;
    margin: 10px;
}

.navigation a {
    text-decoration: none;
    color: white;
    font-size: 18px;
    padding: 12px 18px;
    border: 2px solid white;
    border-radius: 8px;
    transition: 0.3s;
}

.navigation a:hover {
    background-color: white;
    color: #4d8bf5;
}


.container {
    max-width: 900px;
    margin: 30px auto;
    background-color: white;
    padding: 30px;
    border-radius: 12px;
}

.subtitle {
    margin-bottom: 15px;
    font-size: 18px;
}

h2 {
    margin-top: 30px;
    margin-bottom: 15px;
    color: #4d8bf5;
}

p {
    margin-bottom: 15px;
}

.form-section {
    margin-top: 40px;
}

.form-container {
    display: flex;
    justify-content: center;
}

#feedbackForm {
    width: 100%;
    max-width: 500px;
    background-color: #f0f0f0;
    padding: 25px;
    border-radius: 12px;
}

#feedbackForm input,
#feedbackForm textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #bbb;
    border-radius: 8px;
    font-size: 16px;
}

#feedbackForm textarea {
    resize: vertical;
    min-height: 140px;
}

#feedbackForm button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 8px;
    background-color: #4d8bf5;
    color: white;
    font-size: 18px;
    cursor: pointer;
    transition: 0.3s;
}

#feedbackForm button:hover {
    background-color: #2f6fe0;
}

footer {
    background-color: #222;
    color: white;
    text-align: center;
    padding: 20px;
    margin-top: 40px;
}

.member-card {
    width: 250px;
    display: inline-block;
    vertical-align: top;
    margin: 15px;
    padding: 15px;
    background-color: #f0f0f0;
    border-radius: 10px;
    text-align: center;
}

.member-card img {
    width: 100%;
    border-radius: 10px;
    margin-bottom: 10px;
}


table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
}

table th,
table td {
    border: 1px solid #ccc;
    padding: 12px;
    text-align: center;
}

table th {
    background-color: #4d8bf5;
    color: white;
}

.image-container img {
    width: 100%;
    height: auto;
    border-radius: 10px;
}

@media screen and (max-width: 768px) {

    header {
        height: auto;
        padding: 30px 15px;
    }

    header h1 {
        font-size: 28px;
        margin-bottom: 30px;
    }

    .navigation li {
        display: block;
        margin: 15px 0;
    }

    .container {
        margin: 15px;
        padding: 20px;
    }

    .member-card {
        width: 100%;
        margin: 15px 0;
    }

    #feedbackForm {
        padding: 20px;
    }

}
